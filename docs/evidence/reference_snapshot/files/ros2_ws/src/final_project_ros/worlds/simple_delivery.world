          <material>
            <ambient>0.25 0.25 0.28 1</ambient>
            <diffuse>0.25 0.25 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="target_blue_00"><static>true</static><pose>0.25 0.00 0.12 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry><material><ambient>0.122 0.467 0.706 1</ambient><diffuse>0.122 0.467 0.706 1</diffuse></material></visual></link></model>
    <model name="distractor_red"><static>true</static><pose>0.34 0.00 0.12 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry><material><ambient>0.839 0.153 0.157 1</ambient><diffuse>0.839 0.153 0.157 1</diffuse></material></visual></link></model>

    <model name="goal_zone">
      <pose>0.10 -0.19 0.055 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.2 0.2 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.9 0.3 1</ambient>
            <diffuse>0.1 0.9 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_goal">
      <static>true</static>
      <pose>0.10 -0.19 0 0 0 0</pose>
      <link name="link">
        <collision name="floor_collision">
          <geometry>
            <box><size>0.24 0.24 0.02</size></box>
          </geometry>
          <pose>0 0 0.06 0 0 0</pose>
        </collision>
        <collision name="wall_x_positive_collision">
          <geometry>
            <box><size>0.02 0.24 0.14</size></box>
          </geometry>
          <pose>0.11 0 0.13 0 0 0</pose>
        </collision>
        <collision name="wall_x_negative_collision">
          <geometry>
            <box><size>0.02 0.24 0.14</size></box>
          </geometry>
          <pose>-0.11 0 0.13 0 0 0</pose>
        </collision>
        <collision name="wall_y_positive_collision">
          <geometry>
            <box><size>0.20 0.02 0.14</size></box>
          </geometry>
          <pose>0 0.11 0.13 0 0 0</pose>
        </collision>
        <collision name="wall_y_negative_collision">
          <geometry>
            <box><size>0.20 0.02 0.14</size></box>
          </geometry>
          <pose>0 -0.11 0.13 0 0 0</pose>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box><size>0.24 0.24 0.02</size></box>
          </geometry>
          <pose>0 0 0.06 0 0 0</pose>
          <material>
            <ambient>0.9 0.8 0.25 1</ambient>
            <diffuse>0.9 0.8 0.25 1</diffuse>
          </material>
        </visual>
        <visual name="wall_x_positive_visual">
          <geometry><box><size>0.02 0.24 0.14</size></box></geometry>
          <pose>0.11 0 0.13 0 0 0</pose>
          <material><ambient>0.9 0.8 0.25 1</ambient><diffuse>0.9 0.8 0.25 1</diffuse></material>
        </visual>
        <visual name="wall_x_negative_visual">
          <geometry><box><size>0.02 0.24 0.14</size></box></geometry>
          <pose>-0.11 0 0.13 0 0 0</pose>
          <material><ambient>0.9 0.8 0.25 1</ambient><diffuse>0.9 0.8 0.25 1</diffuse></material>
        </visual>
