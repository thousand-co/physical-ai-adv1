<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="simple_delivery">
    <gravity>0 0 -9.8</gravity>
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <include>
      <uri>model://sun</uri>
    </include>

    <model name="table">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="base_link">
        <collision name="table_collision">
          <geometry>
            <box>
              <size>3.0 2.0 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="table_visual">
          <geometry>
            <box>
              <size>3.0 2.0 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="conveyor_belt">
      <static>true</static>
      <pose>0.55 0.0 0.04 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.9 0.28 0.08</size></box>
